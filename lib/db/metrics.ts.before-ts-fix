import { turso } from "../turso"

interface Qty {
  crt: number
  pc: number
  total: number
}

interface EntryInput {
  productId: string
  date: string
  batchNumber?: string
  skuCode?: string
  manufacturingDate?: string | null
  ubd?: string | null
  expiryDate?: string | null
  shelfLifeDays?: number | null
  production?: Qty
  demand?: Qty
  sale?: Qty
  salesTarget?: number
  notes?: string
  entryType?: "production" | "sale"
}

function qty(crt = 0, pc = 0, total = 0): Qty {
  return {
    crt: Number(crt || 0),
    pc: Number(pc || 0),
    total: Number(total || 0),
  }
}

async function getPreviousClosingForBatch(
  productId: string,
  batchNumber: string,
  date: string
): Promise<Qty> {
  const result = await turso.execute({
    sql: `
      SELECT dm.closing_crt, dm.closing_pc, dm.closing_total
      FROM daily_metrics dm
      JOIN batches b ON b.id = dm.batch_id
      WHERE b.product_id = ?
        AND b.batch_number = ?
        AND b.date = (
          SELECT MAX(b2.date)
          FROM batches b2
          JOIN daily_metrics dm2 ON dm2.batch_id = b2.id
          WHERE b2.product_id = ?
            AND b2.batch_number = ?
            AND b2.date < ?
        )
      LIMIT 1
    `,
    args: [productId, batchNumber, productId, batchNumber, date],
  })

  if (!result.rows.length) return qty()

  const row = result.rows[0]

  return qty(
    row.closing_crt,
    row.closing_pc,
    row.closing_total
  )
}

async function getPreviousClosingForProduct(
  productId: string,
  date: string
): Promise<Qty> {
  const result = await turso.execute({
    sql: `
      SELECT
        SUM(dm.closing_crt) AS closing_crt,
        SUM(dm.closing_pc) AS closing_pc,
        SUM(dm.closing_total) AS closing_total
      FROM daily_metrics dm
      JOIN batches b ON b.id = dm.batch_id
      WHERE b.product_id = ?
        AND b.date = (
          SELECT MAX(b2.date)
          FROM batches b2
          JOIN daily_metrics dm2 ON dm2.batch_id = b2.id
          WHERE b2.product_id = ?
            AND b2.date < ?
        )
    `,
    args: [productId, productId, date],
  })

  if (!result.rows.length || result.rows[0].closing_total === null) {
    return qty()
  }

  const row = result.rows[0]

  return qty(
    row.closing_crt,
    row.closing_pc,
    row.closing_total
  )
}

async function getOrCreateBatch(
  productId: string,
  date: string,
  batchNumber: string,
  manufacturingDate?: string | null,
  ubd?: string | null,
  expiryDate?: string | null,
  shelfLifeDays?: number | null
): Promise<string> {
  const existing = await turso.execute({
    sql: `
      SELECT id
      FROM batches
      WHERE product_id = ?
        AND date = ?
        AND batch_number = ?
      LIMIT 1
    `,
    args: [productId, date, batchNumber],
  })

  if (existing.rows.length) {
    const batchId = String(existing.rows[0].id)

    await turso.execute({
      sql: `
        UPDATE batches
        SET manufacturing_date = ?,
            ubd = ?,
            expiry_date = ?,
            shelf_life_days = ?
        WHERE id = ?
      `,
      args: [
        manufacturingDate || null,
        ubd || null,
        expiryDate || null,
        shelfLifeDays ?? null,
        batchId,
      ],
    })

    return batchId
  }

  const batchId = crypto.randomUUID()

  await turso.execute({
    sql: `
      INSERT INTO batches (
        id,
        product_id,
        date,
        batch_number,
        manufacturing_date,
        ubd,
        expiry_date,
        shelf_life_days
      )
      VALUES (?, ?, ?, ?, ?, ?, ?, ?)
    `,
    args: [
      batchId,
      productId,
      date,
      batchNumber,
      manufacturingDate || null,
      ubd || null,
      expiryDate || null,
      shelfLifeDays ?? null,
    ],
  })

  return batchId
}

async function getDailyMetric(batchId: string) {
  const result = await turso.execute({
    sql: `
      SELECT *
      FROM daily_metrics
      WHERE batch_id = ?
      LIMIT 1
    `,
    args: [batchId],
  })

  return result.rows.length ? result.rows[0] : null
}

async function saveDailyMetric(
  batchId: string,
  opening: Qty,
  production: Qty,
  demand: Qty,
  sale: Qty,
  salesTarget = 0,
  notes: string | null = null
) {
  const closing = qty(
    opening.crt + production.crt - sale.crt,
    opening.pc + production.pc - sale.pc,
    opening.total + production.total - sale.total
  )

  const existing = await getDailyMetric(batchId)

  if (existing) {
    await turso.execute({
      sql: `
        UPDATE daily_metrics
        SET
          opening_crt = ?,
          opening_pc = ?,
          opening_total = ?,

          production_crt = ?,
          production_pc = ?,
          production_total = ?,

          demand_crt = ?,
          demand_pc = ?,
          demand_total = ?,

          sale_crt = ?,
          sale_pc = ?,
          sale_total = ?,

          closing_crt = ?,
          closing_pc = ?,
          closing_total = ?,

          sales_target = ?,
          notes = ?,
          updated_at = datetime('now')
        WHERE batch_id = ?
      `,
      args: [
        opening.crt,
        opening.pc,
        opening.total,

        production.crt,
        production.pc,
        production.total,

        demand.crt,
        demand.pc,
        demand.total,

        sale.crt,
        sale.pc,
        sale.total,

        closing.crt,
        closing.pc,
        closing.total,

        salesTarget,
        notes,
        batchId,
      ],
    })
  } else {
    await turso.execute({
      sql: `
        INSERT INTO daily_metrics (
          id,
          batch_id,

          opening_crt,
          opening_pc,
          opening_total,

          production_crt,
          production_pc,
          production_total,

          demand_crt,
          demand_pc,
          demand_total,

          sale_crt,
          sale_pc,
          sale_total,

          closing_crt,
          closing_pc,
          closing_total,

          sales_target,
          notes
        )
        VALUES (
          ?, ?,
          ?, ?, ?,
          ?, ?, ?,
          ?, ?, ?,
          ?, ?, ?,
          ?, ?, ?,
          ?, ?
        )
      `,
      args: [
        crypto.randomUUID(),
        batchId,

        opening.crt,
        opening.pc,
        opening.total,

        production.crt,
        production.pc,
        production.total,

        demand.crt,
        demand.pc,
        demand.total,

        sale.crt,
        sale.pc,
        sale.total,

        closing.crt,
        closing.pc,
        closing.total,

        salesTarget,
        notes,
      ],
    })
  }
}

/**
 * PRODUCTION
 *
 * Production always belongs to the batch entered by the user.
 * Opening is the previous closing of THAT SAME BATCH.
 */
async function saveProduction(input: EntryInput) {
  const {
    productId,
    date,
    batchNumber,
    skuCode,
    manufacturingDate = null,
    ubd = null,
    expiryDate = null,
    shelfLifeDays = null,
    production = qty(),
    demand = qty(),
    salesTarget = 0,
    notes,
  } = input

  if (!batchNumber?.trim()) {
    throw new Error("Batch Number / Code is required for production.")
  }

  if (skuCode !== undefined) {
    await turso.execute({
      sql: `UPDATE products SET sku_code = ? WHERE id = ?`,
      args: [skuCode, productId],
    })
  }

  const batchId = await getOrCreateBatch(
    productId,
    date,
    batchNumber.trim(),
    manufacturingDate,
    ubd,
    expiryDate,
    shelfLifeDays
  )

  const existing = await getDailyMetric(batchId)

  const opening = existing
    ? qty(
        existing.opening_crt,
        existing.opening_pc,
        existing.opening_total
      )
    : await getPreviousClosingForBatch(
        productId,
        batchNumber.trim(),
        date
      )

  const existingDemand = existing
    ? qty(
        existing.demand_crt,
        existing.demand_pc,
        existing.demand_total
      )
    : demand

  const existingSale = existing
    ? qty(
        existing.sale_crt,
        existing.sale_pc,
        existing.sale_total
      )
    : qty()

  await saveDailyMetric(
    batchId,
    opening,
    production,
    existingDemand,
    existingSale,
    existing ? Number(existing.sales_target || 0) : salesTarget,
    existing ? String(existing.notes || "") : notes ?? null
  )

  return {
    batchId,
    type: "production",
    batchNumber: batchNumber.trim(),
  }
}

/**
 * FEFO SALES
 *
 * Sales do NOT ask the user to choose a batch.
 *
 * Available batches are sorted by UBD:
 *
 * earliest UBD -> sold first
 *
 * If that batch does not have enough stock,
 * the remaining quantity automatically moves
 * to the next earliest UBD batch.
 */
async function saveSale(input: EntryInput) {
  const {
    productId,
    date,
    skuCode,
    sale = qty(),
  } = input

  const requestedSale = Number(sale.total || 0)

  if (requestedSale <= 0) {
    throw new Error("Sale quantity must be greater than zero.")
  }

  if (skuCode !== undefined) {
    await turso.execute({
      sql: `UPDATE products SET sku_code = ? WHERE id = ?`,
      args: [skuCode, productId],
    })
  }

  /**
   * Find every batch which has stock available on this date.
   *
   * We use the latest closing BEFORE the selected date,
   * then add today's production and subtract today's
   * already-recorded sales.
   */
  const batchesResult = await turso.execute({
    sql: `
      SELECT
        b.id,
        b.batch_number,
        b.manufacturing_date,
        b.ubd,
        b.expiry_date,
        b.shelf_life_days,

        COALESCE(prev.closing_total, 0) AS previous_closing,

        COALESCE(today.production_total, 0) AS today_production,
        COALESCE(today.sale_total, 0) AS today_sale,

        COALESCE(prev.closing_total, 0)
          + COALESCE(today.production_total, 0)
          - COALESCE(today.sale_total, 0) AS available_stock

      FROM batches b

      LEFT JOIN (
        SELECT
          b1.product_id,
          b1.batch_number,
          dm1.closing_total
        FROM batches b1
        JOIN daily_metrics dm1 ON dm1.batch_id = b1.id
        WHERE b1.date = (
          SELECT MAX(b2.date)
          FROM batches b2
          JOIN daily_metrics dm2 ON dm2.batch_id = b2.id
          WHERE b2.product_id = b1.product_id
            AND b2.batch_number = b1.batch_number
            AND b2.date < ?
        )
      ) prev
        ON prev.product_id = b.product_id
       AND prev.batch_number = b.batch_number

      LEFT JOIN (
        SELECT
          b3.product_id,
          b3.batch_number,
          dm3.production_total,
          dm3.sale_total
        FROM batches b3
        JOIN daily_metrics dm3 ON dm3.batch_id = b3.id
        WHERE b3.date = ?
      ) today
        ON today.product_id = b.product_id
       AND today.batch_number = b.batch_number

      WHERE b.product_id = ?
        AND b.date <= ?

      GROUP BY b.batch_number

      HAVING available_stock > 0

      ORDER BY
        CASE
          WHEN b.ubd IS NULL OR b.ubd = '' THEN 1
          ELSE 0
        END,
        b.ubd ASC,
        CASE
          WHEN b.expiry_date IS NULL OR b.expiry_date = '' THEN 1
          ELSE 0
        END,
        b.expiry_date ASC,
        b.manufacturing_date ASC,
        b.batch_number ASC
    `,
    args: [date, date, productId, date],
  })

  let remaining = requestedSale
  const allocations: Array<{
    batchNumber: string
    quantity: number
  }> = []

  for (const row of batchesResult.rows) {
    if (remaining <= 0) break

    const available = Number(row.available_stock || 0)

    if (available <= 0) continue

    const allocated = Math.min(remaining, available)

    allocations.push({
      batchNumber: String(row.batch_number),
      quantity: allocated,
    })

    remaining -= allocated
  }

  if (remaining > 0) {
    const availableTotal = requestedSale - remaining

    throw new Error(
      `CANNOT DISPATCH ${requestedSale}. Only ${availableTotal} stock is available across all FEFO batches.`
    )
  }

  /**
   * Apply each FEFO allocation to its batch.
   */
  for (const allocation of allocations) {
    const batchNumber = allocation.batchNumber

    const batchResult = await turso.execute({
      sql: `
        SELECT
          b.id,
          b.manufacturing_date,
          b.ubd,
          b.expiry_date,
          b.shelf_life_days
        FROM batches b
        WHERE b.product_id = ?
          AND b.batch_number = ?
          AND b.date <= ?
        ORDER BY b.date DESC
        LIMIT 1
      `,
      args: [productId, batchNumber, date],
    })

    if (!batchResult.rows.length) continue

    const batch = batchResult.rows[0]

    const batchId = await getOrCreateBatch(
      productId,
      date,
      batchNumber,
      batch.manufacturing_date ? String(batch.manufacturing_date) : null,
      batch.ubd ? String(batch.ubd) : null,
      batch.expiry_date ? String(batch.expiry_date) : null,
      batch.shelf_life_days !== null
        ? Number(batch.shelf_life_days)
        : null
    )

    const existing = await getDailyMetric(batchId)

    const opening = existing
      ? qty(
          existing.opening_crt,
          existing.opening_pc,
          existing.opening_total
        )
      : await getPreviousClosingForBatch(
          productId,
          batchNumber,
          date
        )

    const production = existing
      ? qty(
          existing.production_crt,
          existing.production_pc,
          existing.production_total
        )
      : qty()

    const demand = existing
      ? qty(
          existing.demand_crt,
          existing.demand_pc,
          existing.demand_total
        )
      : qty()

    const oldSale = existing
      ? qty(
          existing.sale_crt,
          existing.sale_pc,
          existing.sale_total
        )
      : qty()

    const newSale = qty(
      0,
      0,
      oldSale.total + allocation.quantity
    )

    await saveDailyMetric(
      batchId,
      opening,
      production,
      demand,
      newSale,
      existing ? Number(existing.sales_target || 0) : 0,
      existing ? String(existing.notes || "") : null
    )
  }

  return {
    type: "sale",
    requested: requestedSale,
    allocations,
  }
}

export async function upsertEntry(input: EntryInput) {
  if (input.entryType === "sale") {
    return saveSale(input)
  }

  return saveProduction(input)
}

/**
 * Metrics API used by the existing metrics page.
 */
export async function getMetricsForDate(date: string) {
  const result = await turso.execute({
    sql: `
      SELECT
        p.id AS product_id,
        p.name,
        p.sku_code,
        p.category,
        p.unit,
        COALESCE(p.pcs_per_crt, 1) AS pcs_per_crt,

        GROUP_CONCAT(DISTINCT b.batch_number) AS batch_number,

        MIN(b.manufacturing_date) AS manufacturing_date,
        MAX(b.ubd) AS ubd,
        MAX(b.expiry_date) AS expiry_date,
        MAX(b.shelf_life_days) AS shelf_life_days,

        SUM(dm.opening_crt) AS opening_crt,
        SUM(dm.opening_pc) AS opening_pc,
        SUM(dm.opening_total) AS opening_total,

        SUM(dm.production_crt) AS production_crt,
        SUM(dm.production_pc) AS production_pc,
        SUM(dm.production_total) AS production_total,

        SUM(dm.demand_crt) AS demand_crt,
        SUM(dm.demand_pc) AS demand_pc,
        SUM(dm.demand_total) AS demand_total,

        SUM(dm.sale_crt) AS sale_crt,
        SUM(dm.sale_pc) AS sale_pc,
        SUM(dm.sale_total) AS sale_total,

        SUM(dm.closing_crt) AS closing_crt,
        SUM(dm.closing_pc) AS closing_pc,
        SUM(dm.closing_total) AS closing_total,

        SUM(dm.sales_target) AS sales_target

      FROM products p
      JOIN batches b
        ON b.product_id = p.id
       AND b.date = ?

      JOIN daily_metrics dm
        ON dm.batch_id = b.id

      GROUP BY p.id

      ORDER BY p.category, p.name
    `,
    args: [date],
  })

  return result.rows
}

/**
 * DASHBOARD
 *
 * Important:
 *
 * A product's current stock on a selected day is NOT restricted
 * to batches entered on that day.
 *
 * We find the latest metric for EVERY batch up to the selected date.
 *
 * Therefore:
 *
 * 10 Aug batch -> still appears on 20 Aug if stock remains.
 * 15 Aug batch -> appears on 20 Aug if stock remains.
 * 20 Aug production -> appears immediately on 20 Aug.
 *
 * Today's production = only today's production.
 * Today's sales = only today's sales.
 * Current stock = closing stock on that day.
 */
export async function getDashboardData(date: string) {
  const productsResult = await turso.execute({
    sql: `
      SELECT
        id,
        name,
        sku_code,
        category,
        unit,
        COALESCE(pcs_per_crt, 1) AS pcs_per_crt,
        COALESCE(shelf_life_days, 0) AS shelf_life_days
      FROM products
      ORDER BY category, name
    `,
  })

  const batchRowsResult = await turso.execute({
    sql: `
      SELECT
        p.id AS product_id,
        p.name,
        p.sku_code,
        p.category,
        p.unit,
        COALESCE(p.pcs_per_crt, 1) AS pcs_per_crt,

        b.batch_number,
        b.manufacturing_date,
        b.ubd,
        b.expiry_date,
        b.shelf_life_days,

        dm.opening_crt,
        dm.opening_pc,
        dm.opening_total,

        dm.production_crt,
        dm.production_pc,
        dm.production_total,

        dm.demand_crt,
        dm.demand_pc,
        dm.demand_total,

        dm.sale_crt,
        dm.sale_pc,
        dm.sale_total,

        dm.closing_crt,
        dm.closing_pc,
        dm.closing_total,

        b.date AS metric_date

      FROM products p

      JOIN batches b
        ON b.product_id = p.id
       AND b.date = (
          SELECT MAX(b2.date)
          FROM batches b2
          JOIN daily_metrics dm2
            ON dm2.batch_id = b2.id
          WHERE b2.product_id = p.id
            AND b2.batch_number = b.batch_number
            AND b2.date <= ?
       )

      JOIN daily_metrics dm
        ON dm.batch_id = b.id

      WHERE b.date <= ?

      ORDER BY
        p.category,
        p.name,

        CASE
          WHEN b.ubd IS NULL OR b.ubd = '' THEN 1
          ELSE 0
        END,

        b.ubd ASC,
        b.expiry_date ASC,
        b.manufacturing_date ASC,
        b.batch_number ASC
    `,
    args: [date, date],
  })

  /**
   * Today's activity is fetched separately.
   *
   * This is extremely important:
   * current stock comes from latest closing,
   * but production/sales shown on the selected page
   * must ONLY be today's production/sales.
   */
  const todayRowsResult = await turso.execute({
    sql: `
      SELECT
        b.product_id,
        b.batch_number,

        dm.production_crt,
        dm.production_pc,
        dm.production_total,

        dm.demand_crt,
        dm.demand_pc,
        dm.demand_total,

        dm.sale_crt,
        dm.sale_pc,
        dm.sale_total

      FROM batches b
      JOIN daily_metrics dm
        ON dm.batch_id = b.id

      WHERE b.date = ?
    `,
    args: [date],
  })

  const todayByBatch = new Map<string, any>()

  for (const row of todayRowsResult.rows) {
    todayByBatch.set(
      `${String(row.product_id)}::${String(row.batch_number)}`,
      row
    )
  }

  const productsById = new Map<string, any>()

  for (const p of productsResult.rows) {
    productsById.set(String(p.id), p)
  }

  const categories = new Map<string, any[]>()

  for (const row of batchRowsResult.rows) {
    const productId = String(row.product_id)
    const p = productsById.get(productId)

    if (!p) continue

    const key = `${productId}::${String(row.batch_number)}`
    const today = todayByBatch.get(key)

    const currentStock = Number(row.closing_total || 0)

    /**
     * Only display a batch if:
     *
     * 1. It has stock remaining, OR
     * 2. It had activity today.
     *
     * This means a sold-out old batch doesn't clutter
     * the current inventory unnecessarily.
     */
    const hasTodayActivity =
      Number(today?.production_total || 0) !== 0 ||
      Number(today?.sale_total || 0) !== 0

    if (currentStock <= 0 && !hasTodayActivity) {
      continue
    }

    const category = String(p.category)

    if (!categories.has(category)) {
      categories.set(category, [])
    }

    const productList = categories.get(category)!

    let product = productList.find(
      item => item.id === productId
    )

    if (!product) {
      product = {
        id: productId,
        name: String(p.name),
        skuCode: String(p.sku_code || ""),
        category,
        unit: p.unit,
        pcsPerCrt: Number(p.pcs_per_crt || 1),
        hasEntry: true,

        batchNumber: null,
        manufacturingDate: null,
        ubd: null,
        expiryDate: null,
        shelfLifeDays: p.shelf_life_days
          ? Number(p.shelf_life_days)
          : null,

        opening: qty(),
        production: qty(),
        demand: qty(),
        sale: qty(),
        closing: qty(),

        salesTarget: 0,
        currentStock: 0,

        batches: [],
      }

      productList.push(product)
    }

    const todayProduction = qty(
      today?.production_crt,
      today?.production_pc,
      today?.production_total
    )

    const todayDemand = qty(
      today?.demand_crt,
      today?.demand_pc,
      today?.demand_total
    )

    const todaySale = qty(
      today?.sale_crt,
      today?.sale_pc,
      today?.sale_total
    )

    const batch = {
      batchNumber: String(row.batch_number),

      manufacturingDate: row.manufacturing_date
        ? String(row.manufacturing_date)
        : null,

      ubd: row.ubd
        ? String(row.ubd)
        : null,

      expiryDate: row.expiry_date
        ? String(row.expiry_date)
        : null,

      opening: qty(
        row.opening_crt,
        row.opening_pc,
        row.opening_total
      ),

      /**
       * ONLY TODAY'S production.
       */
      production: todayProduction,

      demand: todayDemand,

      /**
       * ONLY TODAY'S sales.
       */
      sale: todaySale,

      /**
       * CURRENT stock as of selected date.
       */
      currentStock,

      metricDate: String(row.metric_date),
    }

    product.batches.push(batch)

    /**
     * Product-level totals:
     *
     * opening = stock entering the selected day
     * production = production on selected day
     * sale = sale on selected day
     * currentStock = stock available at end of selected day
     */
    product.opening.total += Number(row.opening_total || 0)
    product.opening.crt += Number(row.opening_crt || 0)
    product.opening.pc += Number(row.opening_pc || 0)

    product.production.total += Number(todayProduction.total || 0)
    product.production.crt += Number(todayProduction.crt || 0)
    product.production.pc += Number(todayProduction.pc || 0)

    product.demand.total += Number(todayDemand.total || 0)
    product.demand.crt += Number(todayDemand.crt || 0)
    product.demand.pc += Number(todayDemand.pc || 0)

    product.sale.total += Number(todaySale.total || 0)
    product.sale.crt += Number(todaySale.crt || 0)
    product.sale.pc += Number(todaySale.pc || 0)

    product.currentStock += currentStock
    product.closing.total = product.currentStock

    if (!product.batchNumber) {
      product.batchNumber = String(row.batch_number)
    }
  }

  /**
   * FEFO order at product level.
   */
  for (const products of categories.values()) {
    for (const product of products) {
      product.batches.sort((a: any, b: any) => {
        if (!a.ubd && !b.ubd) return 0
        if (!a.ubd) return 1
        if (!b.ubd) return -1

        return String(a.ubd).localeCompare(String(b.ubd))
      })
    }
  }

  return Array.from(categories.entries()).map(
    ([category, products]) => ({
      category,
      products,
    })
  )
}

/**
 * RANGE VIEW
 *
 * For a date range:
 *
 * - production = production DURING range
 * - sales = sales DURING range
 * - current stock = closing stock on endDate
 * - batches remain separated
 */
export async function getPeriodDashboardData(
  startDate: string,
  endDate: string
) {
  if (startDate === endDate) {
    return getDashboardData(startDate)
  }

  const productsResult = await turso.execute({
    sql: `
      SELECT
        id,
        name,
        sku_code,
        category,
        unit,
        COALESCE(pcs_per_crt, 1) AS pcs_per_crt,
        COALESCE(shelf_life_days, 0) AS shelf_life_days
      FROM products
      ORDER BY category, name
    `,
  })

  const rangeRowsResult = await turso.execute({
    sql: `
      SELECT
        p.id AS product_id,
        b.batch_number,

        MAX(b.manufacturing_date) AS manufacturing_date,
        MAX(b.ubd) AS ubd,
        MAX(b.expiry_date) AS expiry_date,
        MAX(b.shelf_life_days) AS shelf_life_days,

        SUM(dm.production_crt) AS production_crt,
        SUM(dm.production_pc) AS production_pc,
        SUM(dm.production_total) AS production_total,

        SUM(dm.demand_crt) AS demand_crt,
        SUM(dm.demand_pc) AS demand_pc,
        SUM(dm.demand_total) AS demand_total,

        SUM(dm.sale_crt) AS sale_crt,
        SUM(dm.sale_pc) AS sale_pc,
        SUM(dm.sale_total) AS sale_total

      FROM products p
      JOIN batches b
        ON b.product_id = p.id
      JOIN daily_metrics dm
        ON dm.batch_id = b.id

      WHERE b.date >= ?
        AND b.date <= ?

      GROUP BY
        p.id,
        b.batch_number

      ORDER BY
        CASE
          WHEN MAX(b.ubd) IS NULL OR MAX(b.ubd) = '' THEN 1
          ELSE 0
        END,
        MAX(b.ubd) ASC,
        b.batch_number ASC
    `,
    args: [startDate, endDate],
  })

  const endStock = await getDashboardData(endDate)

  const endProductMap = new Map<string, any>()

  for (const group of endStock) {
    for (const product of group.products) {
      endProductMap.set(product.id, product)
    }
  }

  const productInfo = new Map<string, any>()

  for (const p of productsResult.rows) {
    productInfo.set(String(p.id), p)
  }

  const categories = new Map<string, any[]>()

  for (const row of rangeRowsResult.rows) {
    const productId = String(row.product_id)
    const p = productInfo.get(productId)

    if (!p) continue

    const category = String(p.category)

    if (!categories.has(category)) {
      categories.set(category, [])
    }

    let product = categories
      .get(category)!
      .find(item => item.id === productId)

    if (!product) {
      const endProduct = endProductMap.get(productId)

      product = {
        id: productId,
        name: String(p.name),
        skuCode: String(p.sku_code || ""),
        category,
        unit: p.unit,
        pcsPerCrt: Number(p.pcs_per_crt || 1),
        hasEntry: true,

        batchNumber: null,
        manufacturingDate: null,
        ubd: null,
        expiryDate: null,
        shelfLifeDays: p.shelf_life_days
          ? Number(p.shelf_life_days)
          : null,

        opening: qty(),
        production: qty(),
        demand: qty(),
        sale: qty(),

        closing: qty(
          0,
          0,
          Number(endProduct?.currentStock || 0)
        ),

        salesTarget: 0,

        currentStock: Number(
          endProduct?.currentStock || 0
        ),

        batches: [],
      }

      categories.get(category)!.push(product)
    }

    const production = qty(
      row.production_crt,
      row.production_pc,
      row.production_total
    )

    const demand = qty(
      row.demand_crt,
      row.demand_pc,
      row.demand_total
    )

    const sale = qty(
      row.sale_crt,
      row.sale_pc,
      row.sale_total
    )

    const batchNumber = String(row.batch_number)

    const endBatch = endProduct?.batches?.find(
      (b: any) => b.batchNumber === batchNumber
    )

    product.batches.push({
      batchNumber,

      manufacturingDate: row.manufacturing_date
        ? String(row.manufacturing_date)
        : null,

      ubd: row.ubd
        ? String(row.ubd)
        : null,

      expiryDate: row.expiry_date
        ? String(row.expiry_date)
        : null,

      opening: qty(),

      production,

      demand,

      sale,

      currentStock: Number(
        endBatch?.currentStock || 0
      ),
    })

    product.production.total += production.total
    product.production.crt += production.crt
    product.production.pc += production.pc

    product.demand.total += demand.total
    product.demand.crt += demand.crt
    product.demand.pc += demand.pc

    product.sale.total += sale.total
    product.sale.crt += sale.crt
    product.sale.pc += sale.pc

    if (!product.batchNumber) {
      product.batchNumber = batchNumber
    }
  }

  for (const products of categories.values()) {
    for (const product of products) {
      product.batches.sort((a: any, b: any) => {
        if (!a.ubd && !b.ubd) return 0
        if (!a.ubd) return 1
        if (!b.ubd) return -1

        return String(a.ubd).localeCompare(String(b.ubd))
      })
    }
  }

  return Array.from(categories.entries()).map(
    ([category, products]) => ({
      category,
      products,
    })
  )
}
